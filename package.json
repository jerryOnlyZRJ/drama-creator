{
  "name": "drama-creator",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI video production workspace",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "dev:tauri": "tauri dev",
    "build": "node scripts/build.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:tauri": "npm run build:sidecar && tauri build",
    "test": "node --test tests/*.test.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:tauri-env": "node scripts/check-tauri-env.mjs",
    "import:episode": "node scripts/import-episode.mjs"
  },
  "dependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@yao-pkg/pkg": "^6.20.0",
    "esbuild": "^0.28.2"
  },
  "pkg": {
    "assets": [
      "node_modules/keytar/build/Release/keytar.node"
    ]
  },
  "license": "Apache-2.0"
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drama Creator",
  "version": "0.1.0",
  "identifier": "com.dramacreator.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173/",
    "beforeBuildCommand": "node scripts/build.mjs",
    "frontendDist": "http://127.0.0.1:5173/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Drama Creator",
        "url": "http://127.0.0.1:5173/",
        "width": 1280,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "externalBin": [
      "binaries/drama-creator-server"
    ],
    "resources": [
      "../dist",
      "../package.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
